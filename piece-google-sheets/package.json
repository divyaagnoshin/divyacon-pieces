    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "@googleapis/drive": "20.2.0",
    "@googleapis/sheets": "13.0.2",
    "csv-parse": "5.6.0",
    "dayjs": "1.11.9",
    "gaxios": "6.7.1",
