{
  "name": "@divyacon/piece-image-helper",
  "version": "0.1.0",
  "description": "DivyaCon image-helper connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.MIT-AP"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vendor": "node ../scripts/vendor-ap.mjs piece-image-helper"
  },
  "dependencies": {
    "@agnocon/core-utils": "0.2.0",
    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "exifreader": "4.40.1",
    "heic-convert": "2.1.0",
    "jimp": "^0.22.12",
    "sharp": "^0.35.2",
    "mime-types": "2.1.35"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.5.4",
    "@types/mime-types": "2.1.1"
  },
  "license": "MIT",
  "agnocon": {
    "originVersion": "0.1.20"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "agnocon",
    "connector"
  ]
}