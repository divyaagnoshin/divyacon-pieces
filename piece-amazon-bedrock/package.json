  },
  "dependencies": {
    "@agnocon/core-utils": "0.2.0",
    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-bedrock": "^3.987.0",
    "@aws-sdk/client-bedrock-runtime": "^3.987.0",
    "@aws-sdk/client-sts": "3.974.0",
