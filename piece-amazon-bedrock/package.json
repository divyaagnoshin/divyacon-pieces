{
  "name": "@divyacon/piece-amazon-bedrock",
  "version": "0.1.0",
  "description": "DivyaCon amazon-bedrock connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
