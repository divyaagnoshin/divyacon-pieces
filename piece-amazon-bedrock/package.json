    "@smithy/signature-v4": "5.3.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.5.4"
  },
  "license": "MIT",
  "agnocon": {
    "originVersion": "0.2.2"
