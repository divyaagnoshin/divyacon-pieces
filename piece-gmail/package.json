{
  "name": "@divyacon/piece-gmail",
  "version": "0.18.6",
  "description": "DivyaCon Gmail connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.MIT-AP"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vendor": "node ../scripts/vendor-ap.mjs piece-gmail"
  },
  "dependencies": {
    "@agnocon/core-utils": "0.2.0",
    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "@googleapis/gmail": "17.0.0",
    "@googleapis/oauth2": "5.0.1",
    "dayjs": "1.11.9",
    "google-auth-library": "10.5.0",
    "mailparser": "3.9.3",
    "mime-types": "2.1.35",
    "nodemailer": "8.0.5"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.5.4",
    "@types/mime-types": "2.1.1",
    "@types/mailparser": "3.4.6",
    "@types/nodemailer": "7.0.11"
  },
  "license": "MIT",
  "agnocon": {
    "originVersion": "0.18.6"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "agnocon",
    "connector"
  ]
}
