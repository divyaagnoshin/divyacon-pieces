{
  "name": "@divyacon/piece-text-helper",
  "version": "0.1.0",
  "description": "DivyaCon text-helper connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.MIT-AP"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "vendor": "node ../scripts/vendor-ap.mjs piece-text-helper"
  },
  "dependencies": {
    "@agnocon/core-utils": "0.2.0",
    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "@joplin/turndown": "4.0.85",
    "@joplin/turndown-plugin-gfm": "1.0.67",
    "jsdom": "^24.0.0",
    "showdown": "2.1.0",
    "slugify": "1.6.6",
    "string-strip-html": "8.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "typescript": "5.5.4",
    "@types/jsdom": "^21.1.6",
    "@types/showdown": "2.0.6",
    "@types/turndown": "5.0.6"
  },
  "license": "MIT",
  "agnocon": {
    "originVersion": "0.6.4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
