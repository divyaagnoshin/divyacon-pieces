    "@agnocon/core-utils": "0.2.0",
    "@agnocon/piece-types": "0.3.1",
    "@agnocon/pieces-common": "0.12.8",
    "@agnocon/pieces-framework": "0.36.0",
    "tslib": "2.6.2",
    "@ai-sdk/amazon-bedrock": "3.0.97",
    "@ai-sdk/anthropic": "3.0.72",
    "@ai-sdk/azure": "3.0.55",
    "@ai-sdk/google": "3.0.65",
    "@ai-sdk/mcp": "1.0.11",
    "@ai-sdk/openai": "3.0.54",
    "@ai-sdk/openai-compatible": "2.0.42",
    "@ai-sdk/provider-utils": "4.0.24",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@openrouter/ai-sdk-provider": "2.1.1",
    "ai": "6.0.170",
    "ai-gateway-provider": "3.1.1",
    "ajv": "8.18.0",
    "mime-types": "2.1.35",
    "zod": "4.3.6"
