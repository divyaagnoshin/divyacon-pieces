{
  "name": "@divyacon/piece-ai",
  "version": "0.1.0",
  "description": "DivyaCon ai connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
