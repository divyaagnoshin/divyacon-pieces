{
  "name": "@divyacon/piece-types",
  "version": "0.1.0",
  "description": "DivyaCon types connector",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE.MIT-AP"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json || node -e \"process.exit(require('fs').existsSync('dist/index.js')?0:1)\"",
    "vendor": "node ../scripts/vendor-ap.mjs piece-types",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@agnocon/core-utils": "0.2.0",
    "tslib": "2.6.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "agnocon": {
    "originVersion": "0.3.1"
  },
  "keywords": [
    "agnocon"
  ]
}