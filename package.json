{
  "name": "divyacon-pieces-poc",
  "version": "1.0.0",
  "private": true,
  "description": "DivyaCon POC connectors (Gmail & Slack)",
  "workspaces": [
    "piece-gmail",
    "piece-slack"
  ],
  "scripts": {
